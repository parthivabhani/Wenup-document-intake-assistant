# Copy to .env.local and fill in. With NO keys set, the app runs in demo mode
# using a deterministic mock assistant (clearly labelled in the UI).

# Primary provider. Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional extra fallback provider. Free key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Optional fallback on different infrastructure. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b
# CEREBRAS_MODEL=gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
# LLM_PROVIDER=mock   # force demo mode even when keys are set
